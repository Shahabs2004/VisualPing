<Window x:Class="VisualPing.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:VisualPing.Controls"
        xmlns:viewModels="clr-namespace:VisualPing.ViewModels"
        Title="Visual Ping Monitor"
        Width="960"
        Height="680"
        MinWidth="420"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{StaticResource WindowBackground}"
        Topmost="{Binding AlwaysOnTop, Mode=TwoWay}"
        Loaded="Window_Loaded"
        SizeChanged="Window_SizeChanged">
    <Grid x:Name="windowLayout">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="headerBorder"
                Grid.Row="0"
                Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,0,1"
                Padding="18,14">
            <WrapPanel>
                <StackPanel Width="260" Margin="0,0,24,0" VerticalAlignment="Center">
                    <TextBlock Text="Visual Ping Monitor" Style="{StaticResource TitleText}" />
                    <TextBlock Text="Live network latency · In-memory history"
                               Style="{StaticResource MutedText}"
                               Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Save Settings"
                            Command="{Binding SaveSettingsCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,0" />
                    <Button Content="Load Settings"
                            Command="{Binding LoadSettingsCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,0" />
                    <Button Content="Exit"
                            Command="{Binding ExitCommand}"
                            Style="{StaticResource SecondaryButton}" />
                </StackPanel>
            </WrapPanel>
        </Border>

        <ScrollViewer x:Name="contentScroll"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Disabled"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="contentGrid" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="240" />
                </Grid.ColumnDefinitions>

                <Border x:Name="graphHost"
                        Grid.Row="0"
                        Grid.Column="0"
                        MinHeight="160"
                        Margin="0,0,10,0"
                        Background="Black"
                        BorderBrush="{StaticResource Border}"
                        BorderThickness="1"
                        CornerRadius="10"
                        ClipToBounds="True">
                    <Grid>
                        <controls:PingGraphControl x:Name="pingGraph"
                                                  History="{Binding History}"
                                                  RefreshTrigger="{Binding HistoryVersion}"
                                                  ShowGrid="{Binding ShowGrid}"
                                                  TimeoutMilliseconds="{Binding TimeoutMilliseconds}" />

                        <Border x:Name="historyOverlay"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="12"
                                Background="#66000000"
                                CornerRadius="5"
                                Padding="8,4"
                                IsHitTestVisible="False">
                            <TextBlock Text="{Binding HistorySummary}"
                                       Foreground="#E2E8F0"
                                       FontSize="11" />
                        </Border>

                        <TextBlock Text="Start monitoring to see ping history"
                                   Foreground="#94A3B8"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HistoryVersion}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsPureDisplay}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <StackPanel x:Name="sidePanel" Grid.Row="0" Grid.Column="1" Width="240">
                    <GroupBox Header="Statistics" MinWidth="220" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Text="Ping Count" Style="{StaticResource StatisticLabel}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PingCount}" Style="{StaticResource StatisticValue}" />
                            <TextBlock Grid.Row="1" Text="Current Ping" Style="{StaticResource StatisticLabel}" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CurrentPing}" Style="{StaticResource CurrentPingText}" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="2" Text="Average Ping" Style="{StaticResource StatisticLabel}" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AveragePing}" Style="{StaticResource StatisticValue}" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="3" Text="Packet Loss" Style="{StaticResource StatisticLabel}" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PacketLoss}" Style="{StaticResource StatisticValue}" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="4" Text="Duration" Style="{StaticResource StatisticLabel}" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Duration}" Style="{StaticResource StatisticValue}" Margin="0,6,0,0" />
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="Quick Settings">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Ping Interval (ms)"
                                           Style="{StaticResource StatisticLabel}"
                                           Margin="0,0,8,0" />
                                <ComboBox Grid.Column="1"
                                          MinWidth="92"
                                          ItemsSource="{x:Static viewModels:MainWindowViewModel.Intervals}"
                                          SelectedValue="{Binding IntervalMilliseconds, Mode=TwoWay}" />
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Timeout (ms)"
                                           Style="{StaticResource StatisticLabel}"
                                           Margin="0,0,8,0" />
                                <ComboBox Grid.Column="1"
                                          MinWidth="92"
                                          ItemsSource="{x:Static viewModels:MainWindowViewModel.Timeouts}"
                                          SelectedValue="{Binding TimeoutMilliseconds, Mode=TwoWay}" />
                            </Grid>

                            <TextBlock Text="History Capacity (100–50,000)"
                                       Style="{StaticResource StatisticLabel}"
                                       Margin="0,4,0,6" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="historyCapacityInput"
                                         Width="92"
                                         MaxLength="5"
                                         Text="{Binding HistoryCapacityText, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="History capacity"
                                         ToolTip="Enter a value from 100 to 50,000 and select Apply.">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter"
                                                    Command="{Binding ApplyHistoryCapacityCommand}"
                                                    CommandParameter="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                <Button Grid.Column="1"
                                        Content="Apply"
                                        Command="{Binding ApplyHistoryCapacityCommand}"
                                        CommandParameter="{Binding Text, ElementName=historyCapacityInput}"
                                        Style="{StaticResource SecondaryButton}"
                                        Margin="8,0,0,0" />
                            </Grid>

                            <CheckBox Content="Auto-start on launch"
                                      IsChecked="{Binding AutoStart, Mode=TwoWay}"
                                      ToolTip="Start monitoring automatically when the application opens." />
                            <CheckBox Content="Show Grid"
                                      IsChecked="{Binding ShowGrid, Mode=TwoWay}" />
                            <CheckBox Content="Always on Top"
                                      IsChecked="{Binding AlwaysOnTop, Mode=TwoWay}" />
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border x:Name="pingControlsBorder"
                Grid.Row="2"
                Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,0,0"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center"
                         AutomationProperties.Name="Host name or IP address"
                         ToolTip="Host name or IP address" />
                <Button Grid.Column="1"
                        Content="{Binding PingButtonText}"
                        Command="{Binding TogglePingCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Margin="10,0,0,0" />
                <Button Grid.Column="2"
                        Content="Clear"
                        Command="{Binding ClearHistoryCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Margin="8,0,0,0" />
            </Grid>
        </Border>

        <Border x:Name="statusBorder"
                Grid.Row="3"
                Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,0,0"
                Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource Accent}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasStatusError}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource Danger}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusMessage}"
                               Style="{StaticResource StatusText}"
                               Margin="8,0,0,0" />
                </StackPanel>
                <TextBlock x:Name="historySummaryText"
                           Grid.Column="1"
                           Text="{Binding HistorySummary}"
                           Style="{StaticResource MutedText}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0" />
            </Grid>
        </Border>
    </Grid>
</Window>
